# No Anthropic API key needed — the scraper uses the claude CLI
# which runs through your Claude Pro subscription.
# Make sure Claude Code is installed: https://claude.ai/code

# Your Notion integration token (for logging applications)
# Get it from: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_...

# Your Notion database ID (already pre-configured below)
NOTION_DATABASE_ID=fcadfa0f55a54b6f99b5e2fadfdf1ad9

# ── Telegram Bot (optional — for phone access) ───────────────────────────────
# 1. Message @BotFather on Telegram → /newbot → copy the token here
TELEGRAM_TOKEN=

# 2. Get your personal chat ID by messaging @userinfobot on Telegram
#    This locks the bot so only YOU can use it
TELEGRAM_CHAT_ID=
